    <string name="section_intro_description">La sección de apertura que establece la tonalidad, el tempo, el ambiente y el estilo.</string>
    <string name="section_verse_description">La sección que cuenta la historia. La misma música cada vez; la letra cambia.</string>
    <string name="section_pre_chorus_description">Una sección corta y opcional que crea tensión antes del estribillo.</string>
    <string name="section_chorus_description">El punto emocional y pegadizo. Repite la misma letra y el mensaje principal.</string>
    <string name="section_bridge_description">Una sección de contraste, a menudo cerca del medio, con acordes o melodía nuevos.</string>
    <string name="section_outro_description">La sección final que cierra o resuelve la canción.</string>

